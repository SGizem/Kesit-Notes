{
    "manifest_version": 3,
    "name": "Kesit",
    "version": "0.3.0",
    "description": "Bir cümlenin altını çiz, sağ tıkla, kaydet. Kaynağı ve bağlamıyla birlikte.",
    "minimum_chrome_version": "116",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "action": {
        "default_title": "Kesit",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png"
        }
    },
    "side_panel": {
        "default_path": "sidepanel.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "permissions": ["contextMenus", "storage", "scripting", "activeTab", "sidePanel"],
    "optional_host_permissions": ["<all_urls>"],
    "content_scripts": [
        {
            "matches": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
            "js": ["bridge.js"],
            "run_at": "document_start"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["icons/icon-32.png"],
            "matches": ["<all_urls>"]
        }
    ],
    "commands": {
        "save-selection": {
            "suggested_key": { "default": "Alt+Shift+K" },
            "description": "Seçili metni Kesit'e kaydet"
        }
    }
}
